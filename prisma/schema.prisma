generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated-client" // project-relative output — Turbopack re-reads project files (node_modules/.prisma cache went stale after the avatar push)
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Pulse Chat — mobile messenger schema (no mocks, all real data)
// ─────────────────────────────────────────────────────────────

model User {
  id                 String                    @id @default(cuid())
  name               String
  username           String?                   @unique // @handle (3-20 chars) — replaces raw IDs everywhere in the UI
  about              String                    @default("Hey there! I'm using Pulse.")
  color              String                    @default("emerald") // avatar palette key: emerald|rose|amber|violet|teal|orange|pink|cyan
  avatar             String? // profile photo path (/uploads/<uuid>.<ext>) — null = palette avatar fallback
  statusEmoji        String? // Discord-style custom status glyph (null = none)
  statusText         String? // Discord-style custom status line (null = none)
  preferences        String? // JSON-encoded Pulse prefs blob (see src/lib/prefs-defaults.ts)
  createdAt          DateTime                  @default(now())
  lastSeenAt         DateTime                  @default(now())
  appInstalls        AppInstall[]
  wallet             UserWallet?
  ledger             WalletLedger[]
  hubTasks           HubTask[]
  logEvents          LogEvent[]
  marketListings     MarketListing[]           @relation("MarketSeller")
  marketPurchases    MarketListing[]           @relation("MarketBuyer")
  participations     ConversationParticipant[]
  messages           Message[]
  savedMessages      SavedMessage[]
  quickPhrases       QuickPhrase[]
  stories            StatusStory[]
  folders            Folder[]
  xp                 Int                       @default(0) // Twitch-style channel points earned by real activity
  xpToday            Int                       @default(0) // XP earned today (daily-cap accounting)
  xpDay              String                    @default("") // UTC 'YYYY-MM-DD' bucket xpToday belongs to
  tournamentEntries  TournamentPlayer[]
  reminders          Reminder[]
  streaks            ConversationStreak[]
  verificationsGiven UserVerification[]        @relation("verificationOwner")
  automationsCreated Automation[]              @relation("AutomationCreator")

  @@index([name])
}

/**
 * Beeper/Zulip-style per-message reminder — the app nudges the owner
 * when remindAt passes (client due-loop toasts + Reminders sheet).
 */
model Reminder {
  id             String    @id @default(cuid())
  userId         String
  conversationId String
  messageId      String? // anchor message (null = conversation-level reminder)
  note           String    @default("") // free-text context shown in the nudge
  remindAt       DateTime
  firedAt        DateTime? // set once the nudge has been delivered
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

/**
 * Snapchat-style per-user-per-conversation daily streak — bumped on the
 * FIRST message a user sends in a conversation each UTC day.
 */
model ConversationStreak {
  id             String @id @default(cuid())
  conversationId String
  userId         String
  lastDay        String // UTC 'YYYY-MM-DD' of the last streaked day
  count          Int    @default(0)
  best           Int    @default(0) // all-time high
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastDay])
}

/**
 * WhatsApp-style call history row — written when a 1:1 call reaches a
 * terminal state (completed / missed / declined). Drives the Calls page.
 */
model CallLog {
  id             String   @id @default(cuid())
  conversationId String
  callerId       String
  calleeId       String
  kind           String   @default("voice") // voice | video
  status         String   @default("missed") // completed | missed | declined
  durationSec    Int      @default(0)
  startedAt      DateTime @default(now())

  @@index([calleeId, startedAt])
  @@index([callerId, startedAt])
}

/**
 * Signal-style safety-number verification — one row per (viewer, peer) pair
 * after the viewer confirms the peer's safety number in person. The number
 * itself is derived deterministically from both stable user ids (see
 * src/lib/safety.ts) so both sides always see the same digits.
 */
model UserVerification {
  id         String   @id @default(cuid())
  ownerId    String // the user who performed the verification
  peerId     String // the peer whose safety number was verified
  verifiedAt DateTime @default(now())
  owner      User     @relation("verificationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, peerId])
  @@index([ownerId])
}

/**
 * Hub economy wallet — real balances moved by check-ins, transfers, swaps,
 * red packets and marketplace trades (every change writes a ledger row).
 */
model UserWallet {
  userId      String    @id
  coins       Int       @default(0) // Pulse Coins (PC)
  gems        Int       @default(0) // Gems (GEM)
  streak      Int       @default(0) // consecutive daily check-ins
  lastCheckIn DateTime? // last daily check-in watermark (UTC day gate)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Immutable money trail — every balance mutation appends exactly one row.
 */
model WalletLedger {
  id             String   @id @default(cuid())
  userId         String
  kind           String // checkin|transfer_in|transfer_out|swap|gift|redpacket_send|redpacket_claim|market_sell|market_buy
  asset          String // "PC" | "GEM"
  amount         Int // signed from the owner's perspective (+in / -out)
  note           String   @default("")
  counterpartyId String? // other user in transfers / red packets / trades
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * Hub personal kanban task (Chanty/Ryver parity) — three real columns.
 */
model HubTask {
  id        String   @id @default(cuid())
  ownerId   String
  title     String
  status    String   @default("todo") // "todo" | "doing" | "done"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
}

/**
 * Hub Apps ecosystem — a user's real connection to a catalog app
 * (hub-catalog.ts ids). One row per (user, app); status toggles.
 */
model AppInstall {
  id          String   @id @default(cuid())
  userId      String
  appId       String // hub-catalog app id (e.g. "telegram", "discord")
  installedAt DateTime @default(now())
  status      String   @default("connected") // connected | muted
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([appId])
}

/**
 * Hub marketplace listing — real coin-priced offers between users.
 */
model MarketListing {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  description String   @default("")
  price       Int
  asset       String   @default("PC")
  status      String   @default("open") // "open" | "sold"
  buyerId     String?
  createdAt   DateTime @default(now())
  seller      User     @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer       User?    @relation("MarketBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/**
 * DevOps terminal stream — every economy/social action appends a real event.
 */
model LogEvent {
  id        String   @id @default(cuid())
  userId    String?
  kind      String // checkin|transfer|swap|redpacket|market|hand|system|message
  message   String
  meta      String? // optional JSON blob
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/**
 * User-authored one-tap phrases (Among Us wheel / canned responses — real data).
 */
model QuickPhrase {
  id        String   @id @default(cuid())
  userId    String
  text      String
  position  Int      @default(0) // sort order within the user's rail
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
}

model Conversation {
  id                String                    @id @default(cuid())
  isGroup           Boolean                   @default(false)
  name              String? // group title; null for DMs
  description       String                    @default("") // channel/group purpose line (channel directory + info page)
  photo             String? // channel/group photo path (/uploads/<uuid>.<ext>) — null = palette icon fallback
  inviteCode        String?                   @unique // shareable join code (groups only; null = no active link)
  ttlSeconds        Int                       @default(0) // disappearing-message TTL (0 = off; applied at send time)
  broadcastMode     Boolean                   @default(false) // Discord-stage/Telegram-channel style admin-only posting
  screenPrivacy     Boolean                   @default(false) // R38 Signal screen security: frost the message area while the Pulse window is unfocused
  isSelf            Boolean                   @default(false) // Signal-style Note to Self (single participant = owner)
  appKey            String?                   @unique // hub Apps-matrix community chat (app number as string, e.g. "4")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt // bumped on every new message → list sort
  participants      ConversationParticipant[]
  messages          Message[]
  scheduledMessages ScheduledMessage[]
  webhooks          Webhook[]
  kanbanCards       KanbanCard[]
  events            GroupEvent[]
  gameMatches       GameMatch[]
  topics            Topic[]
  tournaments       Tournament[]
  folderEntries     FolderConversation[]
  automations       Automation[]

  @@index([updatedAt])
}

/**
 * R39 — keyword-triggered auto-reply (the honest ManyChat/Landbot
 * "bot flow" adaptation): an admin of the conversation stores a trigger
 * phrase + reply; the send path matches human messages word-boundary
 * case-insensitively and lands the reply authored by the admin creator
 * with viaAutomation=true. First matching automation only, never chained.
 */
model Automation {
  id             String       @id @default(cuid())
  conversationId String
  trigger        String // 2-40 chars, matched as a standalone phrase (case-insensitive)
  reply          String // 1-500 chars — the message landed on a match
  createdById    String // admin who authored the rule (also the reply's sender)
  enabled        Boolean      @default(true)
  hits           Int          @default(0) // lifetime fire count
  lastFiredAt    DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([conversationId, enabled])
}

/**
 * Discord-style incoming webhook — external services POST to
 * /api/webhooks/[token] and land as a named bot message in the room.
 */
model Webhook {
  id             String       @id @default(cuid())
  conversationId String
  token          String       @unique @default(cuid())
  name           String
  avatarColor    String       @default("emerald")
  createdBy      String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/**
 * Collaborative whiteboard — every stroke is a persisted polyline so the
 * canvas survives close/reopen and syncs across members by timestamp polling.
 */
model WhiteboardStroke {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  color          String
  width          Float
  points         String // JSON [[x,y], ...] normalized 0..1 canvas coords
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

/**
 * BeReal/Telegram-style 24h status story (image or text-on-gradient).
 */
model StatusStory {
  id         String      @id @default(cuid())
  userId     String
  imagePath  String? // uploaded image (via /api/uploads); null = text story
  caption    String      @default("")
  background String      @default("emerald") // gradient key for text stories
  createdAt  DateTime    @default(now())
  expiresAt  DateTime // createdAt + 24h — hard-filtered everywhere after
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  views      StoryView[]

  @@index([userId, expiresAt])
}

model StoryView {
  id        String      @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime    @default(now())
  story     StatusStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  role           String       @default("member") // "admin" | "member" (groups: creator is admin)
  joinedAt       DateTime     @default(now()) // join watermark (tie-breaker for admin succession)
  lastReadAt     DateTime     @default(now()) // read receipts / unread counts
  pinnedAt       DateTime? // per-user pinned-to-top
  mutedUntil     DateTime? // per-user notification mute watermark (null = unmuted)
  archivedAt     DateTime? // per-user archive watermark (null = active; cleared when others send new msgs)
  handRaisedAt   DateTime? // Clubhouse-style raised hand (null = lowered)
  screenPrivacy  Boolean    @default(false) // R42: per-VIEWER screen security (personal veil, OR'd with the conversation-wide flag)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String               @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  deletedAt      DateTime? // soft delete → "message deleted" tombstone
  replyToId      String? // quoted message (reply feature)
  imagePath      String? // stored image filename via /api/uploads (image message)
  audioPath      String? // stored voice-note filename via /api/uploads (audio message)
  durationMs     Int? // voice-note length in milliseconds
  filePath       String? // R40: stored document filename via /api/uploads (file message)
  fileName       String? // R40: original document filename shown on the bubble (1-120 chars)
  fileSize       Int? // R40: document byte size (0..10_485_760)
  editedAt       DateTime? // last edit timestamp (null = never edited → "edited" label)
  pinnedAt       DateTime? // pinned within the conversation (null = not pinned)
  pinnedBy       String? // userId who pinned (display attribution)
  parentId       String? // Slack/Zulip thread root this reply belongs to (null = top-level)
  topicId        String? // Zulip-style topic this message is filed under (null = General)
  anon           Boolean              @default(false) // Session/SimpleX-style anonymous send
  viaAutomation  Boolean              @default(false) // R39: authored by a keyword automation (never re-triggers the engine)
  anonAlias      String? // deterministic per-(user,conversation) incognito alias (sender-side display)
  viewOnce       Boolean              @default(false) // Snapchat/WhatsApp view-once media gate
  viewedAt       DateTime? // when the non-sender consumed a view-once attachment
  viewedBy       String? // who consumed it
  expiresAt      DateTime? // disappearing-message deadline (hard-purged after)
  linkUrl        String? // canonical preview link (og unfurl) attached to this message
  kind           String               @default("text") // text|image|audio|sticker|location|code|task|redpacket
  payload        String? // JSON payload for rich kinds (sticker pack/glyph, lat/lng, code lang/source, tx data)
  createdAt      DateTime             @default(now())
  sender         User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]            @relation("MessageReplies")
  parent         Message?             @relation("MessageThreads", fields: [parentId], references: [id], onDelete: Cascade)
  threadReplies  Message[]            @relation("MessageThreads")
  reactions      Reaction[]
  poll           Poll?
  topic          Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  redPacket      RedPacket?
  translations   MessageTranslation[]
  linkPreview    LinkPreview?         @relation(fields: [linkUrl], references: [url])
  savedBy        SavedMessage[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@index([parentId])
}

/**
 * Live poll card attached to exactly one message (Discord/Slack-style).
 */
model Poll {
  id        String       @id @default(cuid())
  messageId String       @unique
  question  String
  closedAt  DateTime? // null = voting open; set by the creator → final results frozen
  createdAt DateTime     @default(now())
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options   PollOption[]
}

model PollOption {
  id       String     @id @default(cuid())
  pollId   String
  text     String
  position Int        @default(0) // display order (stable across tally updates)
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([pollId, position])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId]) // single-choice polls — revote moves the vote
}

/**
 * Telegram-style saved/starred messages (per-user bookmarks).
 */
model SavedMessage {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, savedAt])
}

/**
 * Telegram/WhatsApp-style delayed send — flushed to a real message by the dispatch sweep.
 */
model ScheduledMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  scheduledAt    DateTime
  sentAt         DateTime? // null = pending
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sentAt])
  @@index([conversationId, senderId])
}

/**
 * Per-language LLM translation persisted on demand (Webex-style caption translation).
 */
model MessageTranslation {
  id        String   @id @default(cuid())
  messageId String
  lang      String
  text      String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, lang])
  @@index([messageId])
}

/**
 * Cached OG/link metadata — fetched live from the web, keyed by canonical URL.
 */
model LinkPreview {
  url         String    @id
  title       String?
  description String?
  imageUrl    String?
  siteName    String?
  fetchedAt   DateTime  @default(now())
  messages    Message[]
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ═══════════════════════════════════════════════════════════════
// R24 — beyond-chat wave 3: topics, folders, xp/tournaments
// ═══════════════════════════════════════════════════════════════

/**
 * Zulip-style topic — first-class information architecture inside a group.
 * "time is a terrible information architecture": topics turn the chat river
 * into indexed knowledge. Messages may file under one topic (null = General).
 */
model Topic {
  id             String       @id @default(cuid())
  conversationId String
  name           String
  emoji          String       @default("💬")
  createdById    String?
  createdAt      DateTime     @default(now())
  lastMessageAt  DateTime     @default(now()) // bumped on every filed message → topic sort
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([conversationId, name])
  @@index([conversationId, lastMessageAt])
}

/**
 * Signal/Beeper-style chat folder — user-scoped bucket ordering the chats list.
 */
model Folder {
  id        String               @id @default(cuid())
  userId    String
  name      String
  emoji     String               @default("📂")
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   FolderConversation[]

  @@index([userId, position])
}

model FolderConversation {
  id             String       @id @default(cuid())
  folderId       String
  conversationId String
  position       Int          @default(0)
  folder         Folder       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([folderId, conversationId])
  @@index([folderId, position])
}

/**
 * Twitch/Plato-style tournament season inside one conversation. While
 * status = "running", every game win in that room feeds the standings.
 */
model Tournament {
  id             String             @id @default(cuid())
  conversationId String
  name           String
  game           String             @default("tictactoe")
  status         String             @default("running") // running | finished
  createdById    String?
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  entries        TournamentPlayer[]

  @@index([conversationId, status])
}

model TournamentPlayer {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  points       Int        @default(0) // +1 per game win while the season runs
  wins         Int        @default(0)
  losses       Int        @default(0)
  draws        Int        @default(0)
  joinedAt     DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, points])
}

// ═══════════════════════════════════════════════════════════════
// R23 — beyond-chat wave 2: red packets, games, kanban, events
// ═══════════════════════════════════════════════════════════════

/**
 * WeChat-style red packet riding a chat message — the sender's wallet is
 * debited atomically at creation; `slices` holds a precomputed random split
 * (JSON number[] summing exactly to `total`) and `grabbed` is the atomic
 * cursor into it. Unclaimed slices refund to the sender after `expiresAt`.
 */
model RedPacket {
  id        String          @id @default(cuid())
  messageId String          @unique
  senderId  String
  total     Int // PC debited from the sender at creation
  count     Int // number of grab slices
  grabbed   Int             @default(0) // atomic counter — next slice index
  slices    String // JSON number[] — random split summing exactly to total
  note      String          @default("") // festive caption on the bubble
  expiresAt DateTime // createdAt + 24h
  createdAt DateTime        @default(now())
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  grabs     RedPacketGrab[]
}

model RedPacketGrab {
  id        String    @id @default(cuid())
  packetId  String
  userId    String
  amount    Int
  createdAt DateTime  @default(now())
  packet    RedPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)

  @@unique([packetId, userId])
  @@index([packetId, createdAt])
}

/**
 * In-chat game match — tic-tac-toe first. `board` is 9 chars
 * (' ' empty / 'X' / 'O'), `playerOId` null = open challenge any room
 * member can claim via the join button on the card.
 */
model GameMatch {
  id             String       @id @default(cuid())
  conversationId String
  game           String       @default("tictactoe")
  playerXId      String // creator plays X
  playerOId      String? // null = open challenge (join button on card)
  board          String       @default("         ")
  turn           String       @default("X") // side to move: "X" | "O"
  status         String       @default("active") // active|x_won|o_won|draw|abandoned
  winnerId       String?
  winLine        String? // JSON number[] — winning triple for the highlight
  moveCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/**
 * Group kanban card — three real columns per conversation, position-stable
 * ordering, optional assignee resolved against room members client-side.
 */
model KanbanCard {
  id              String       @id @default(cuid())
  conversationId  String
  title           String
  column          String       @default("todo") // todo|doing|done
  position        Int          @default(0) // stable sort within (conversation, column)
  assigneeId      String?
  createdById     String?
  sourceMessageId String? // Chanty-style provenance: card born from a chat message
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, column, position])
}

/**
 * Group calendar event with per-member RSVP.
 */
model GroupEvent {
  id             String       @id @default(cuid())
  conversationId String
  title          String
  description    String       @default("")
  location       String       @default("")
  startsAt       DateTime
  createdById    String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  rsvps          EventRsvp[]

  @@index([conversationId, startsAt])
}

model EventRsvp {
  id          String     @id @default(cuid())
  eventId     String
  userId      String
  status      String     @default("going") // going|maybe|no
  checkedInAt DateTime? // BAND-style attendance stamp (set during the event window)
  createdAt   DateTime   @default(now())
  event       GroupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ── R41: durable attachment store ─────────────────────────────
// The sandbox wipes files from disk while DB rows persist (proven twice:
// R37 avatars, R41 demo PDFs). Upload bytes now live in SQLite (BLOB) as
// the durable source of truth; the disk copy stays as the fast path.
model UploadedFile {
  name      String   @id // stored "<uuid>.<ext>" filename
  mime      String
  bytes     Bytes
  size      Int
  createdAt DateTime @default(now())
}
