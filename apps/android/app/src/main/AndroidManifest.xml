<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wave 3 calls: keep mic capture alive in an ongoing-call foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Wave R1-W2D: video calls keep camera capture alive in the same service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- LiveUpdate: hand the downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- R1-W2H D45: re-arm reminder one-shots after reboot (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".PulseApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pulse"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: pulse://chat/<id> — parity with the web hash router -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pulse" />
            </intent-filter>
        </activity>

        <!-- LiveUpdate: read-only URI for the system installer on cacheDir/liveupdate. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updater"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/liveupdate_paths" />
        </provider>

        <!-- Wave 1 media: read-only URIs for downloaded message files (open/share). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pulse_file_paths" />
        </provider>

        <!-- Wave 3 calls: ongoing-call foreground service (microphone type;
             Wave R1-W2D: + camera for video calls). -->
        <service
            android:name="app.pulse.feature.calls.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Wave 5 voice rooms: keep mic capture alive in an ongoing-room
             foreground service (same idiom: ALL services live in the app
             manifest; feature modules carry no manifests). -->
        <service
            android:name="app.pulse.feature.voice.VoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- R1-W2H D45: after reboot the reminder WorkManager one-shots have no
             guarantee of being re-armed in time — BootReceiver re-schedules
             still-future reminders via ReminderNotifier.schedule and fires the
             notify path for ones that came due while the device was off.
             exported=false: the system delivers BOOT_COMPLETED to it regardless. -->
        <receiver
            android:name="app.pulse.android.notify.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
