<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pulse" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- R50-e - the Android 12+ SplashScreen API backport (core-splashscreen):
         carbon launch field, the existing launcher foreground as the icon, and
         a hand-off straight into Theme.Pulse so onCreate installs nothing new
         visually after the splash dismisses. -->
    <style name="Theme.Pulse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#07090B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pulse</item>
    </style>
</resources>
