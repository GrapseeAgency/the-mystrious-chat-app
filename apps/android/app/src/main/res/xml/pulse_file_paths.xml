<?xml version="1.0" encoding="utf-8"?>
<!--
  Wave 1 media hand-off (spec §2 row 9): downloaded message files live under
  cacheDir/downloads and are shared with the system viewer / share sheet via
  the FileProvider authority "${applicationId}.files" (MediaSupport.fileUri).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="downloads"
        path="downloads/" />
    <!-- D30 camera capture: TakePicture writes the full-resolution shot to
         cacheDir/camera before the ≤1280px JPEG upload pipeline consumes it. -->
    <cache-path
        name="camera"
        path="camera/" />
    <!-- R1-W2H D24: exportChat writes the .txt transcript to cacheDir/exports —
         served to the share sheet via MediaSupport.buildShareIntent. -->
    <cache-path
        name="exports"
        path="exports/" />
    <files-path
        name="files"
        path="." />
</paths>
