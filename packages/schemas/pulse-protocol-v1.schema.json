{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pulse wire protocol v2",
  "description": "Canonical JSON shapes captured live from the gateway. Mirrored by Kotlin WireDtos.kt, Swift WireDtos.swift and TS contracts.ts.",
  "definitions": {
    "WireSender": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": ["string", "null"] },
        "color": { "type": ["string", "null"] },
        "avatar": { "type": ["string", "null"] }
      }
    },
    "WireChatMessage": {
      "type": "object",
      "required": ["id", "conversationId", "senderId", "content", "kind", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "kind": { "type": "string", "description": "lowercase wire kind: text|image|voice|video|file|poll|system|sticker|location|red_packet" },
        "createdAt": { "type": "string" },
        "editedAt": { "type": ["string", "null"] },
        "deletedAt": { "type": ["string", "null"] },
        "sender": { "$ref": "#/definitions/WireSender" },
        "parentId": { "type": ["string", "null"] },
        "pinnedAt": { "type": ["string", "null"] },
        "viewOnce": { "type": ["boolean", "null"] },
        "anon": { "type": ["boolean", "null"] }
      }
    },
    "WireMessagesPage": {
      "type": "object",
      "required": ["messages"],
      "properties": {
        "messages": { "type": "array", "items": { "$ref": "#/definitions/WireChatMessage" } },
        "hasMore": { "type": "boolean" },
        "total": { "type": "integer" }
      }
    },
    "WireConversationSummary": {
      "type": "object",
      "required": ["id", "isGroup", "members"],
      "properties": {
        "id": { "type": "string" },
        "isGroup": { "type": "boolean" },
        "name": { "type": ["string", "null"] },
        "photo": { "type": ["string", "null"] },
        "updatedAt": { "type": ["string", "null"] },
        "members": { "type": "array", "items": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "role": { "type": ["string", "null"] } } } },
        "lastMessage": { "$ref": "#/definitions/WireChatMessage" },
        "unreadCount": { "type": ["integer", "null"], "minimum": 0 },
        "pinnedAt": { "type": ["string", "null"] },
        "mutedUntil": { "type": ["string", "null"] },
        "archivedAt": { "type": ["string", "null"] },
        "broadcastMode": { "type": ["boolean", "null"] },
        "myStreak": { "type": ["integer", "null"] }
      }
    },
    "WireConversationsPage": {
      "type": "object",
      "required": ["conversations"],
      "properties": {
        "conversations": { "type": "array", "items": { "$ref": "#/definitions/WireConversationSummary" } }
      }
    }
  }
}
